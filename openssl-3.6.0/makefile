		-o libssl-3-x64.dll libssl.def \
		./libssl-shlib-libssl.res.obj @libssl-3-x64.dll.args \
		-lcrypto  $(LIB_EX_LIBS)
	rm -f apps/libssl-3-x64.dll
	rm -f fuzz/libssl-3-x64.dll
	cp -p libssl-3-x64.dll apps/
	cp -p libssl-3-x64.dll fuzz/
	rm -f test/libssl-3-x64.dll
	cp -p libssl-3-x64.dll test/
