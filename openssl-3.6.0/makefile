libcrypto.dll.a: libcrypto-3-x64.dll
libcrypto-3-x64.dll: ./libcrypto-shlib-libcrypto.res.obj \
                     libcrypto-3-x64.dll.args libcrypto.def \
                     providers/libdefault.a providers/libcommon.a
	$(CC) $(LIB_CFLAGS) $(LIB_LDFLAGS) -Wl,--out-implib=libcrypto.dll.a \
		-o libcrypto-3-x64.dll libcrypto.def \
		./libcrypto-shlib-libcrypto.res.obj \
		@libcrypto-3-x64.dll.args \
		providers/libdefault.a providers/libcommon.a  $(LIB_EX_LIBS)
	rm -f apps/libcrypto-3-x64.dll
	rm -f fuzz/libcrypto-3-x64.dll
	cp -p libcrypto-3-x64.dll apps/
	cp -p libcrypto-3-x64.dll fuzz/
	rm -f test/libcrypto-3-x64.dll
	cp -p libcrypto-3-x64.dll test/
