./libcrypto-shlib-libcrypto.res.obj: libcrypto.rc
	$(RC)  -I. -Iinclude -Iproviders/common/include -Iproviders/implementations/include  -DAES_ASM -DBSAES_ASM -DCMLL_ASM -DECP_NISTZ256_ASM -DGHASH_ASM -DKECCAK1600_ASM -DMD5_ASM -DOPENSSL_BN_ASM_GF2m -DOPENSSL_BN_ASM_MONT -DOPENSSL_BN_ASM_MONT5 -DOPENSSL_CPUID_OBJ -DOPENSSL_IA32_SSE2 -DOPENSSL_SM3_ASM -DPOLY1305_ASM -DRC4_ASM -DSHA1_ASM -DSHA256_ASM -DSHA512_ASM -DSM4_ASM -DVPAES_ASM -DWHIRLPOOL_ASM -DX25519_ASM $(RCFLAGS)  -o $@ libcrypto.rc
libcrypto.rc: util/mkrc.pl configdata.pm
	$(PERL) util/mkrc.pl libcrypto > $@
crypto/aes/libcrypto-shlib-aes-cfb-avx512.obj: crypto/aes/aes-cfb-avx512.s
